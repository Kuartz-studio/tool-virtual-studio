# Exemple de configuration : copier ce fichier en .env, puis renseigner les valeurs.
# Une variable laissée vide vaut une variable absente : la valeur par défaut s'applique.

# --- Serveur ---
# development, test ou production.
NODE_ENV=development
# Port d'écoute du serveur.
PORT=3000
# Adresse publique de l'appli, sans barre finale : elle sert aux liens des e-mails et aux cookies.
APP_URL=http://localhost:3000

# --- Base de données ---
# pglite://<dossier> : PGlite enregistré dans ce dossier, sans Docker (développement local).
# Le chemin est relatif au dossier de lancement (apps/server avec pnpm dev).
# Un seul processus à la fois peut ouvrir ce dossier : arrêter le serveur avant de lancer une commande dessus.
# memory:// : PGlite en mémoire, pour les tests.
# Ces deux formes sont refusées en production, où DATABASE_URL est l'URL PostgreSQL du service (postgres://…).
DATABASE_URL=pglite://.data/dev

# --- Authentification (Better Auth) ---
# 32 caractères minimum. Cette valeur ne convient qu'au développement :
# en production, en générer une avec « openssl rand -base64 32 ».
BETTER_AUTH_SECRET=secret-de-developpement-a-remplacer-0123456789
# on (par défaut) ou off : limitation des tentatives de connexion.
AUTH_RATE_LIMIT=on

# --- E-mails ---
# memory : les e-mails restent en mémoire (développement, tests). resend est obligatoire en production.
MAILER=memory
# Obligatoires seulement avec MAILER=resend. MAIL_FROM s'écrit « Bureau virtuel <bureau@exemple.fr> ».
RESEND_API_KEY=
MAIL_FROM=

# --- Audio et vidéo (LiveKit) ---
# Sans ces trois variables, l'audio et la vidéo sont désactivés.
# LIVEKIT_URL s'écrit par exemple wss://mon-projet.livekit.cloud.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Carte ---
# Le serveur charge la carte MAPS_DIR/<MAP_KEY>.json.
MAP_KEY=dev-office
# Dossier des cartes. Par défaut : apps/client/public/assets/maps.
MAPS_DIR=

# --- Client ---
# Dossier du client compilé, servi par le serveur. Inutile en développement.
CLIENT_DIST_DIR=

# --- Tests de bout en bout ---
# 1 active les routes réservées aux tests. Ne jamais le définir en production.
E2E=
