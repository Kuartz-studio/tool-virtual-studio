# Exemple de configuration : copier ce fichier en .env à la racine du dépôt, puis renseigner les valeurs.
# `pnpm dev` lit ce fichier ; une variable déjà définie dans l'environnement garde la priorité.
# Une variable laissée vide vaut une variable absente : la valeur par défaut s'applique.

# --- Serveur ---
# development, test ou production.
NODE_ENV=development
# Port d'écoute du serveur. Le serveur Vite du client relaie /api et /socket.io vers le port 4000.
PORT=4000
# Facultatif : l'adresse d'écoute (127.0.0.1 : cette machine seulement). Absente : toutes les interfaces, comme en production.
LISTEN_HOST=
# Adresse de l'appli telle que le navigateur la voit, sans barre finale : elle sert aux liens des e-mails et aux cookies.
# En développement, c'est l'adresse du serveur Vite (apps/client/vite.config.ts, port 5173), pas celle du serveur :
# le navigateur n'ouvre que Vite. En production, c'est l'adresse publique (https://…).
APP_URL=http://localhost:5173

# --- Base de données ---
# pglite://<dossier> : PGlite enregistré dans ce dossier, sans Docker (développement local).
# Le chemin est relatif au dossier de lancement (apps/server avec pnpm dev).
# Un seul processus à la fois peut ouvrir ce dossier : arrêter le serveur avant de lancer une commande dessus.
# memory:// : PGlite en mémoire, pour les tests.
# Ces deux formes sont refusées en production, où DATABASE_URL est l'URL PostgreSQL du service (postgres://…).
DATABASE_URL=pglite://.data/dev

# --- Authentification (Better Auth) ---
# 32 caractères minimum. Cette valeur ne convient qu'au développement :
# en production, en générer une avec « openssl rand -base64 32 ».
BETTER_AUTH_SECRET=secret-de-developpement-a-remplacer-0123456789
# on (par défaut) ou off : limitation des tentatives de connexion.
AUTH_RATE_LIMIT=on

# --- E-mails ---
# none : aucun e-mail ne part ; l'admin copie lui-même les liens d'invitation et de mot de passe depuis le panneau Admin et les
#        transmet (Slack, WhatsApp…). Le mode le moins cher : ni service d'envoi, ni domaine à vérifier. Accepté en production.
# resend : les e-mails partent par Resend (RESEND_API_KEY et MAIL_FROM obligatoires). Accepté en production.
# memory : rien ne part, les e-mails restent en mémoire, leur lien est affiché dans le terminal (développement, tests).
#        Refusé en production : elle exige resend ou none.
MAILER=memory
# Facultatif : seulement avec MAILER=resend, où ils sont obligatoires. MAIL_FROM s'écrit « Bureau virtuel <bureau@exemple.fr> ».
RESEND_API_KEY=
MAIL_FROM=

# --- Audio et vidéo (LiveKit) ---
# Sans l'une de ces trois variables, l'audio et la vidéo sont désactivés (un avertissement le dit au démarrage).
# LIVEKIT_URL s'écrit par exemple wss://mon-projet.livekit.cloud ; une adresse qui n'est pas en wss://, ws://, https:// ou http://
# arrête le démarrage. En local : ws://localhost:7880, avec `livekit-server --dev` (clé devkey, secret secret).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Faux live (essais en local) ---
# `pnpm dev:sim` lance l'appli avec SIM=1 : des personnes fictives (panneau « Bac à sable »), leur fichier audio joué en boucle dans
# la room où l'on est, et aucun appel à LiveKit, même si les variables ci-dessus sont renseignées. Refusé en production.
# Les fichiers audio (mp3, wav, ogg, m4a…) se déposent dans ce dossier, ou depuis le panneau. Par défaut : sim-audio, à la racine.
SIM_AUDIO_DIR=

# --- Carte ---
# Le serveur charge la carte MAPS_DIR/<MAP_KEY>.json : `office` est la grande carte du bureau (73 × 39 cases, 20 bureaux, une grande salle),
# `dev-office` la petite carte des tests (24 × 16, trois bureaux), valeur par défaut.
MAP_KEY=office
# Dossier des cartes. Par défaut : apps/client/public/assets/maps.
MAPS_DIR=

# --- Client ---
# Dossier du client compilé (apps/client/dist), servi par le serveur, relatif au dossier de lancement.
# Inutile en développement : c'est Vite qui sert le client.
CLIENT_DIST_DIR=

# --- Tests de bout en bout ---
# 1 active les routes réservées aux tests (/api/test). Exige MAILER=memory, refusée en production.
E2E=
