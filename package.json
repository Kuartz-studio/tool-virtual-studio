{
  "name": "bureau-virtuel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck && tsc -p e2e",
    "dev": "pnpm -r --parallel dev",
    "dev:sim": "SIM=1 VITE_SIM=1 pnpm -r --parallel dev",
    "build": "pnpm --filter @bureau/client build && pnpm --filter @bureau/server build",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
